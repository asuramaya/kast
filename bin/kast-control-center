#!/usr/bin/env python3
"""Kast Control Center — a capability-gated remote window.

A thin GTK4/Adwaita frontend over `kast control`. It does no protocol work of
its own: it shells out to the kast CLI (which owns the pyatv/gnd backends) for
the device list, each device's capabilities, now-playing, and every action. The
window renders only the controls a device actually reports — an AirPlay-only TV
shows stop + volume, an Apple TV the full remote.

Run system python3 (it has PyGObject/Adwaita); the kast CLI it calls uses its
own pyatv venv. Usage: kast-control-center [target]
"""
import json
import os
import shutil
import sys

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402


def _kast_path():
    here = os.path.dirname(os.path.realpath(__file__))
    cand = os.path.join(here, "kast")
    return cand if os.path.exists(cand) else (shutil.which("kast") or "kast")


KAST = _kast_path()


def run_kast(args, on_json=None, on_done=None):
    """Run `kast <args>` async; parse stdout as JSON for on_json, or report
    stderr to on_done(error_or_None). Keeps the UI responsive."""
    proc = Gio.Subprocess.new(
        [KAST, *args],
        Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)

    def finished(p, res):
        try:
            ok, out, err = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            if on_done:
                on_done(str(e))
            return
        if on_json is not None:
            try:
                on_json(json.loads(out) if out.strip() else None)
            except (json.JSONDecodeError, ValueError):
                if on_done:
                    on_done(err.strip() or "bad response")
                return
        if on_done:
            on_done(err.strip() or None)

    proc.communicate_utf8_async(None, None, finished)


class ControlWindow(Adw.ApplicationWindow):
    def __init__(self, app, target=None):
        super().__init__(application=app, title="Kast Control Center")
        self.set_default_size(360, 540)
        self._target = target
        self._caps = {}
        self._np_timer = 0

        self._toasts = Adw.ToastOverlay()
        self.set_content(self._toasts)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self._toasts.set_child(root)

        header = Adw.HeaderBar()
        self._device_drop = Gtk.DropDown.new_from_strings([])
        self._device_drop.connect("notify::selected", self._on_device_changed)
        header.set_title_widget(self._device_drop)
        root.append(header)

        self._body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                             margin_top=18, margin_bottom=18,
                             margin_start=18, margin_end=18)
        self._body.set_valign(Gtk.Align.START)
        root.append(self._body)

        self._devices = []
        self._load_devices()

    # --- data ---------------------------------------------------------------
    def _load_devices(self):
        def got(data):
            self._devices = data or []
            names = [d.get("name", "?") for d in self._devices]
            self._device_drop.set_model(Gtk.StringList.new(names or ["No devices"]))
            idx = 0
            if self._target:
                for i, d in enumerate(self._devices):
                    if self._target in (d.get("name"), d.get("address")):
                        idx = i
                        break
            if self._devices:
                self._device_drop.set_selected(idx)
                self._select_device(idx)
            else:
                self._show_message("No controllable devices found")
        run_kast(["control"], on_json=got,
                 on_done=lambda e: e and self._show_message(e))

    def _on_device_changed(self, drop, _param):
        i = drop.get_selected()
        if 0 <= i < len(self._devices):
            self._select_device(i)

    def _select_device(self, idx):
        dev = self._devices[idx]
        # gnd mirror sessions have no address; key control by name.
        self._ref = dev.get("address") or dev.get("name")
        self._caps = dev.get("caps", {})
        self._build_controls(dev)
        self._refresh_nowplaying()

    # --- actions ------------------------------------------------------------
    def _do(self, action, arg=None):
        args = ["control", self._ref, action]
        if arg is not None:
            args.append(str(arg))
        run_kast(args, on_done=lambda e: e and self._show_message(e))

    def _show_message(self, text):
        self._toasts.add_toast(Adw.Toast.new(text))

    # --- UI build (capability-gated) ----------------------------------------
    def _build_controls(self, dev):
        child = self._body.get_first_child()
        while child:
            self._body.remove(child)
            child = self._body.get_first_child()

        caps = self._caps
        has = lambda *ks: any(caps.get(k) for k in ks)

        # Now playing
        self._np_label = Gtk.Label(label="", wrap=True, xalign=0)
        self._np_label.add_css_class("title-4")
        if caps.get("now_playing"):
            self._body.append(self._np_label)

        # Transport row
        if has("previous", "play", "pause", "play_pause", "stop", "next"):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6,
                          halign=Gtk.Align.CENTER)
            for icon, action, cap in [
                ("media-skip-backward-symbolic", "previous", "previous"),
                ("media-playback-start-symbolic", "play_pause", "play_pause"),
                ("media-playback-stop-symbolic", "stop", "stop"),
                ("media-skip-forward-symbolic", "next", "next"),
            ]:
                if not caps.get(cap) and not (cap == "play_pause" and has("play", "pause")):
                    continue
                b = Gtk.Button(icon_name=icon)
                b.add_css_class("circular")
                b.connect("clicked", lambda _b, a=action: self._do(a))
                row.append(b)
            self._body.append(row)

        # Volume
        if has("volume", "set_volume", "volume_up", "volume_down"):
            vol = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            down = Gtk.Button(icon_name="audio-volume-low-symbolic")
            up = Gtk.Button(icon_name="audio-volume-high-symbolic")
            down.connect("clicked", lambda _b: self._do("volume_down"))
            up.connect("clicked", lambda _b: self._do("volume_up"))
            vol.append(down)
            if caps.get("set_volume"):
                scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
                scale.set_hexpand(True)
                scale.set_draw_value(False)
                scale.connect("change-value",
                              lambda _s, _t, v: (self._do("set_volume", int(v)), False)[1])
                vol.append(scale)
            vol.append(up)
            self._body.append(vol)

        # D-pad + menu/home
        if caps.get("nav"):
            self._body.append(self._build_dpad())

        # Power
        if has("power_on", "power_off"):
            prow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6,
                           halign=Gtk.Align.CENTER)
            if caps.get("power_on"):
                on = Gtk.Button(label="Power On")
                on.connect("clicked", lambda _b: self._do("power_on"))
                prow.append(on)
            if caps.get("power_off"):
                off = Gtk.Button(label="Power Off")
                off.connect("clicked", lambda _b: self._do("power_off"))
                prow.append(off)
            self._body.append(prow)

        if self._body.get_first_child() is None or (
                not caps.get("now_playing") and len(caps) <= 1):
            note = Gtk.Label(
                label="This device only supports basic control.", wrap=True)
            note.add_css_class("dim-label")
            self._body.append(note)

    def _build_dpad(self):
        grid = Gtk.Grid(row_spacing=6, column_spacing=6, halign=Gtk.Align.CENTER)
        keys = {(0, 1): ("go-up-symbolic", "up"),
                (1, 0): ("go-previous-symbolic", "left"),
                (1, 1): ("media-playback-start-symbolic", "select"),
                (1, 2): ("go-next-symbolic", "right"),
                (2, 1): ("go-down-symbolic", "down")}
        for (r, c), (icon, key) in keys.items():
            b = Gtk.Button(icon_name=icon)
            b.add_css_class("circular")
            b.connect("clicked", lambda _b, k=key: self._do("key", k))
            grid.attach(b, c, r, 1, 1)
        menu = Gtk.Button(icon_name="open-menu-symbolic")
        home = Gtk.Button(icon_name="user-home-symbolic")
        menu.connect("clicked", lambda _b: self._do("key", "menu"))
        home.connect("clicked", lambda _b: self._do("key", "home"))
        grid.attach(menu, 0, 3, 1, 1)
        grid.attach(home, 2, 3, 1, 1)
        return grid

    # --- now playing poll ---------------------------------------------------
    def _refresh_nowplaying(self):
        if self._np_timer:
            GLib.source_remove(self._np_timer)
            self._np_timer = 0
        if not self._caps.get("now_playing"):
            return

        def tick():
            def got(np):
                if np and (np.get("title") or np.get("app")):
                    bits = [b for b in (np.get("title"), np.get("app")) if b]
                    self._np_label.set_label("♫ " + " — ".join(bits))
                else:
                    self._np_label.set_label("Nothing playing")
            run_kast(["control", self._ref, "now-playing"], on_json=got)
            return GLib.SOURCE_CONTINUE

        tick()
        self._np_timer = GLib.timeout_add_seconds(5, tick)


class ControlApp(Adw.Application):
    def __init__(self, target):
        super().__init__(application_id="com.github.asuramaya.kast.ControlCenter",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self._target = target

    def do_activate(self):
        win = ControlWindow(self, self._target)
        win.present()


def main():
    target = sys.argv[1] if len(sys.argv) > 1 else None
    app = ControlApp(target)
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())
