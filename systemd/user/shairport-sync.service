[Unit]
Description=Kast AirPlay Audio Receiver (shairport-sync)
After=graphical-session.target network-online.target
Wants=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kast audio-receiver-run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
