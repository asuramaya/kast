#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 asuramaya and kast contributors
# kast-healthcheck — CLI parity with the family; kast has no daemon to ping
# (docs/STATUS-SEAM.md: kast is the family's one exempt glue layer), so the
# verdict here is instead: the status.json seam, when one exists, agrees
# with live systemd reality, AND the installed sutra_update.py still matches
# its own installed .version anchor (BOOTSTRAP.md, ruling 3e44bd95 item 5) —
# `make check-sutra` only ever proves the repo copy wasn't hand-edited; it
# says nothing about what a real install is actually running. kast ships
# the update spine itself, so a silently-wrong installed copy here has the
# widest blast radius of any vendored module: it's what runs on every future
# `kast update`. No seam yet is not unhealthy — kast only writes one as a
# by-product of a verb actually running, and nothing has run since boot is
# a normal state for a tool with no background service.
#
# Exit 0 (healthy) or 1 (unhealthy) + one line, passive — this only reports,
# it never restarts or repairs anything (that's `kast repair`, on request).
set -uo pipefail

APP_ID="kast"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${APP_ID}"
SEAM_FILE="${RUNTIME_DIR}/status.json"

fail() {
    printf 'kast-healthcheck: UNHEALTHY — %s\n' "$1" >&2
    exit 1
}

command -v jq >/dev/null 2>&1 || fail "jq is required"

# Derived the SAME way kast-update's own bootstrap preamble derives it
# (dirname(dirname(realpath(self)))/share/kast/lib) — this binary is
# installed beside kast-update in every layout, so the arithmetic lands on
# the exact directory kast-update actually imports from.
sutra_note="sutra anchor unknown"
_self="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]:-$0}")"
_sutra_libdir="$(dirname "$(dirname "${_self}")")/share/kast/lib"
_sutra_py="${_sutra_libdir}/sutra_update.py"
_sutra_version="${_sutra_libdir}/sutra_update.version"
# A missing anchor (an install that predates it, or a layout that never
# shipped one) is a DIFFERENT fact from a verified mismatch — collapsing
# both into "fail" would hide a real tamper behind ordinary version skew,
# so "cannot check" only ever becomes a note, never a failure by itself.
if [[ -f "${_sutra_version}" && -f "${_sutra_py}" ]]; then
    _sutra_expected="$(awk '{print $NF}' "${_sutra_version}")"
    _sutra_actual="$(sha256sum "${_sutra_py}" | cut -d' ' -f1)"
    if [[ "${_sutra_expected}" != "${_sutra_actual}" ]]; then
        fail "installed ${_sutra_py} doesn't match its own installed sutra_update.version anchor (hand-edited, or two pills' installers collided)"
    fi
    sutra_note="sutra anchor ok"
fi

live_state() {
    # `is-active --quiet ... && active || inactive` cannot tell "genuinely
    # inactive" from "systemd --user didn't answer" (no bus, no session) --
    # both take the same branch. A bus-unreachable call prints nothing to
    # stdout (confirmed empirically: the error goes to stderr) and exits
    # non-zero, the same shape --quiet reports for a real, cleanly-inactive
    # unit. Read the actual word instead of just the exit code: a real state
    # word means systemd could answer; anything else means it couldn't, and
    # that has to stay a distinct fact from "inactive" rather than being
    # reported as one -- this whole tool exists to catch a drifted claim,
    # and "I couldn't check" reported as "inactive" would be exactly that.
    local out
    out="$(systemctl --user is-active "$1" 2>/dev/null)" || true
    case "${out}" in
        active|inactive|failed|activating|deactivating|reloading|unknown) printf '%s' "${out}" ;;
        *) printf 'unknown' ;;
    esac
}

if [[ ! -f "${SEAM_FILE}" ]]; then
    printf 'kast-healthcheck: ok (no status.json seam yet — kast has no daemon, so nothing has needed to write one; %s)\n' "${sutra_note}"
    exit 0
fi

seam="$(cat "${SEAM_FILE}" 2>/dev/null)" || fail "${SEAM_FILE} unreadable"
jq -e '.version == 1 and has("receivers") and has("devices") and has("session")' >/dev/null 2>&1 <<<"${seam}" \
    || fail "${SEAM_FILE} malformed (unexpected shape)"

drift=""
cannot_verify=""
for pair in "uxplay.service airplay_screen" "shairport-sync.service airplay_audio" "kast-youtube.service youtube"; do
    unit="${pair%% *}"
    key="${pair#* }"
    seam_state="$(jq -r --arg k "${key}" '.receivers[$k] // "unknown"' <<<"${seam}")"
    live="$(live_state "${unit}")"
    if [[ "${live}" == "unknown" ]]; then
        # NOT drift -- a resolved disagreement and "systemd didn't answer"
        # are different facts, and this line exists to keep them different
        # rather than let the loop below fold them into the same verdict.
        cannot_verify="${key} (systemd --user did not answer for ${unit})"
        break
    fi
    if [[ "${seam_state}" != "${live}" ]]; then
        drift="${key} says ${seam_state}, systemd says ${live}"
        break
    fi
done
[[ -z "${cannot_verify}" ]] || fail "cannot verify against systemd (${cannot_verify}) — not a confirmed drift, systemd itself did not answer; retry once the user bus is reachable"
[[ -z "${drift}" ]] || fail "seam drifted from systemd (${drift}) — re-run any kast verb to refresh"

age=$(( $(date +%s) - $(jq -r '.written_at // 0' <<<"${seam}") ))
printf 'kast-healthcheck: ok (seam %ds old, receivers match systemd, %s)\n' "${age}" "${sutra_note}"
